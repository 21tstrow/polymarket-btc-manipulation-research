# Chainlink Data Streams credentials for the BTC/USD collector.
# Copy this file to .env.chainlink and fill in your real values.
#   cp .env.chainlink.example .env.chainlink
# Do NOT commit .env.chainlink. Placeholders only here.

CHAINLINK_DATASTREAMS_API_KEY=your-api-key-here
CHAINLINK_DATASTREAMS_API_SECRET=your-api-secret-here

# Optional: full 32-byte BTC/USD stream ID (0x + 64 hex chars).
# Leave blank to let the collector resolve it via /api/v1/feeds at startup.
CHAINLINK_BTC_USD_STREAM_ID=
